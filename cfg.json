{
	"GlobalParameter": {
		"Type": "singleton",
		"Fields":{
			"DatabaseRetentionDays": "numeric",
			"MaxRetry": "numeric",
			"RetryDelaySeconds": "numeric"
		}
	},
	
	"NotificationServer":{
		"Type": "singleton",
		"Fields":{
			"name": "text",
			"type": "text",
			"host": "text",
			"timeout": "numeric"
		}
	},
    "Queue":{
		"Type": "array",
		"Fields":{
			"Id": "numeric",
			"MaxQueuedItems": "numeric",
			"PriorityOrder": "numeric"
		}
	},
    "Login":{
		"Type": "singleton",
		"Fields":{
			"loginid": "autoinc",
			"Login": "text",
			"Password": "text"
		}
	},
    "Secret":{
		"Type": "singleton",
		"Fields":{
			"Secret": "text"
		}
	},
    "Token":{
		"Type": "singleton",
		"Fields":{
			"Token": "text"
		}
	},
    "Credential":{
		"Type": "singleton",
		"Fields":{
			"Login": "entity"
		}
	},
    "Target":{
		"Type": "array",
		"Fields":{
			"LogicalName": "text",
			"Protocol": "text",
			"Hostname": "text",
			"Credential": "entity",
			"certificate": "text",
			"PublicKeyFilename": "text",
			"port": "numeric",
			"bucket": "text"
		}
	},
   "DataType":{
		"Type": "array",
		"Fields":{
			"LogicalName": "text",
			"ItemType": "text"
		}
	},
	
	"DataPolicy":{
		"Type": "array",
		"Fields":{
		}
	},
	"Periodical":{
		"Type": "singleton",
		"Fields":{
			"PollingInterval": "numeric"
		}
	},
	"SourcePolicy":{
		"Type": "array",
		"Fields":{
			"Source": "text",
			"RelativePath": "text",
			"FilePattern": "text",
			"IsSourceToBePurged": "numeric"
		}
	},
	"DestinationPolicy":{
		"Type": "array",
		"Fields":{
			"Destination": "text",
			"RelativePath": "text",
			"TmpExtension": "text"
		}
	},	
	"Topic":{
		"Type": "array",
		"Fields":{
			"NotificationServer": "text",
			"Topic": "text"
		}
	},
	"Notification":{
		"Type": "array",
		"Fields":{
			"NotificationServer": "text",
			"Topic": "text",
			"TdsOn": "numeric"
		}
	},
	"TransferPolicy":{
		"Type": "array",
		"Fields":{
			"LogicalName": "text",
			"TransferRequestType": "text",
			"QueueId": "numeric",
			"Periodical": "entity",
			"DataType": "entity",
			"SourcePolicy": "entity",
			"DestinationPolicy": "entity",
			"Notifications": "entity"
		}
	},
	
	"TransferRequest":{
		"Type": "array",
		"Fields":{
			"transferrequestid": "autoinc",
			"RequestState": "text",
			"Filename": "text",
			"QueueId": "numeric"
		}
	},
	"QueueTransfersRequest":{
		"Type": "singleton",
		"Fields":{
			"TransferPolicyName": "text",
			"Files": "text_array"
		}
	},
	
	"Scanned_file":{
		"Type": "singleton",
		"Fields":{
			"Trsfpolicyname": "text",
			"FileName": "text"
		}
	},
	"ExecutionSlot":{
		"Type": "singleton",
		"Fields":{
			"QueueCreation": "date",
			"ExecutionStart": "date",
			"ExecutionEnd": "date"
		}
	}
